# Copy to .env.local for development; set the same names in Vercel for production. See ADMIN.md.
MONGODB_URI=mongodb://127.0.0.1:27017/shayan-portfolio
# npx auth secret  (or: npm run admin:password creates one)
AUTH_SECRET=
# Set both with: npm run admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Enquiry emails (resend.com). CONTACT_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
# Optional image uploads from the admin: cloudinary://<key>:<secret>@<cloud-name>
CLOUDINARY_URL=
